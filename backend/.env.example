# Kashif Sanitary Supplies - Backend Environment Configuration

# Server Port (Render provides this automatically as PORT)
PORT=5000

# Turso Database Configuration (From https://app.turso.tech)
# If left blank during local development, falls back to local SQLite file
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# JWT Authentication Secret (Generate a strong random 32+ character string)
JWT_SECRET=kashif_sanitary_secure_production_secret_key_change_me_before_deploying
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma separated list, e.g. Netlify deployment URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,*
